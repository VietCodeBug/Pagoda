{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["@cloudflare/workers-types"]
  },
  "include": ["server/worker.ts", "server/room.ts", "src/lib/protocol.ts", "src/lib/validation.ts", "src/lib/world-layout.ts"],
  "exclude": ["node_modules", "server/**/*.test.ts"]
}
