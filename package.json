{
  "name": "virtual-temple-online",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "concurrently -k -n web,room \"next dev --hostname 0.0.0.0\" \"tsx watch scripts/dev-realtime.ts\"",
    "dev:web": "next dev --hostname 0.0.0.0",
    "dev:realtime": "tsx watch scripts/dev-realtime.ts",
    "build": "next build",
    "build:netlify": "pnpm --package=netlify-cli dlx netlify build --offline",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "assets": "node scripts/prepare-assets.mjs",
    "assets:punch": "node scripts/generate-punch.mjs",
    "assets:garden": "node scripts/optimize-garden.mjs",
    "db:migrate": "tsx scripts/migrate.ts",
    "deploy:realtime": "wrangler deploy",
    "cf:typecheck": "tsc --noEmit -p tsconfig.worker.json",
    "smoke": "tsx scripts/smoke.ts",
    "test:ui": "node scripts/ui-smoke.mjs",
    "test:tabs": "node scripts/two-tabs-smoke.mjs",
    "test:presence": "node scripts/presence-smoke.mjs",
    "test:activities": "node scripts/activities-smoke.mjs",
    "check": "pnpm typecheck && pnpm cf:typecheck && pnpm test",
    "assets:scene": "node scripts/fetch-scene-assets.mjs",
    "storage:upload": "tsx scripts/upload-assets.ts",
    "realtime:check": "tsx scripts/setup-realtime.ts --probe",
    "smoke:neon": "tsx scripts/smoke-neon.ts",
    "env:netlify": "node scripts/netlify-env.mjs export",
    "env:check": "node scripts/netlify-env.mjs check"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@dimforge/rapier3d-compat": "0.19.2",
    "@neon/realtime": "^0.1.2",
    "@neondatabase/serverless": "1.2.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@react-three/postprocessing": "3.2.2",
    "@react-three/rapier": "2.2.0",
    "drizzle-orm": "0.45.4",
    "ecctrl": "2.0.2",
    "lucide-react": "1.66.0",
    "next": "16.4.5",
    "partyserver": "0.5.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "ws": "8.22.1",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261103.1",
    "@electric-sql/pglite": "0.3.16",
    "@playwright/test": "^1.64.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@types/ws": "8.18.2",
    "concurrently": "10.0.6",
    "dotenv": "18.0.9",
    "drizzle-kit": "0.31.11",
    "sharp": "^0.35.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "wrangler": "4.156.2"
  }
}
