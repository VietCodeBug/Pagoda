# Every non-comment line must be NAME=value; never paste a bare URL.
# Server-only PostgreSQL connection string. Legacy NEON_KEY is still accepted.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Generate a random secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required in production. Never prefix this or DATABASE_URL with NEXT_PUBLIC_.
SESSION_SECRET=replace-with-at-least-32-random-characters
# Optional dedicated game-reward key. If empty, the web uses SESSION_SECRET.
# Cloudflare GAME_REWARD_SECRET must contain the same effective value (server only).
GAME_REWARD_SECRET=
# Game-room endpoint read by /api/realtime/config at runtime (Functions scope).
# Leave empty locally to use ws://localhost:1999. Production uses the project's public Worker by default.
REALTIME_URL=
# Legacy setting; REALTIME_URL takes priority. No secret belongs in either variable.
NEXT_PUBLIC_REALTIME_URL=
# Worker-only setting: ALLOWED_ORIGIN=https://YOUR-SITE.netlify.app

# Neon Object Storage (server only). AWS_* names are reserved on Netlify.
# Existing AWS_* variables remain supported for local development.
NEON_STORAGE_ENDPOINT=https://YOUR-BRANCH.storage.c-7.us-east-2.aws.neon.tech
NEON_STORAGE_ACCESS_KEY_ID=
NEON_STORAGE_SECRET_ACCESS_KEY=
NEON_STORAGE_REGION=us-east-2
NEON_STORAGE_BUCKET=pagoda

# Neon Realtime public prayer journal; separate from the game-room WebSocket URL.
NEON_REALTIME_URL=
NEON_REALTIME_SECRET=
# Optional; inferred from the PostgreSQL connection string when omitted.
NEON_REALTIME_DATABASE=

# Optional PostgREST public read. Without a provider JWT, SQL reads remain active.
# This does not enable Neon Auth or install an Auth provider.
NEON_DATA_API_URL=
NEON_DATA_API_TOKEN=

# Optional reference URLs only. Guest login stays active; Neon Auth is not enabled.
NEON_AUTH_URL=
NEON_JWKS_URL=
