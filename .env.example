# Server-only PostgreSQL connection string from Neon. Existing NEON_KEY is accepted too.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Generate a random secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required in production. Never prefix this or DATABASE_URL with NEXT_PUBLIC_.
SESSION_SECRET=replace-with-at-least-32-random-characters
# Public endpoint of the separately deployed Cloudflare Worker (no trailing slash).
# Local development may use ws://localhost:1999; leave empty to use local default.
NEXT_PUBLIC_REALTIME_URL=ws://localhost:1999
# Worker production setting, configured using Wrangler vars: ALLOWED_ORIGIN=https://YOUR-SITE.vercel.app

# Neon Object Storage (server only). Upload script writes the bucket to .env.local.
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
NEON_STORAGE_BUCKET=

# Neon Realtime public prayer journal; separate from the game-room WebSocket URL.
NEON_REALTIME_URL=
NEON_REALTIME_SECRET=
# Optional; inferred from the PostgreSQL connection string when omitted.
NEON_REALTIME_DATABASE=

# Optional PostgREST public read. Without a provider JWT, SQL reads remain active.
# This does not enable Neon Auth or install an Auth provider.
NEON_DATA_API_URL=
NEON_DATA_API_TOKEN=
